# Copy to the shell environment (the backend reads os.environ; no .env loader is bundled)
OPENWEATHER_API_KEY=            # optional; without it, live mode reports "unavailable"
DATABASE_URL=                   # optional; e.g. mysql+pymysql://user:pass@localhost:3306/agrisentry
AGRISENTRY_MODEL_DIR=           # optional; defaults to ../models
CORS_ORIGINS=http://localhost:5173
