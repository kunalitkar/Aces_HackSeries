# Copy this file to backend/.env (git-ignored) and fill in your own values.
# The backend loads backend/.env automatically at startup; restart it after editing.
# Leave a value blank to use the default. Never put keys in the frontend.

# Live weather + place search (https://openweathermap.org/api). Blank = demo scenarios only.
OPENWEATHER_API_KEY=

# Optional chat helper "Ask AgriSentry" (https://console.groq.com). GROQ_MODEL blank = openai/gpt-oss-120b.
GROQ_API_KEY=
GROQ_MODEL=

# Optional permanent storage, e.g. mysql+pymysql://agrisentry:<password>@localhost:3306/agrisentry
# Blank = temporary in-memory storage.
DATABASE_URL=

# Optional folders and production settings
AGRISENTRY_MODEL_DIR=
CORS_ORIGINS=http://localhost:5173
